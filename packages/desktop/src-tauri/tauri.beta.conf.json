{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuoDuoCode Beta",
  "identifier": "com.duoduo.desktop.beta",
  "bundle": {
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/beta/32x32.png",
      "icons/beta/128x128.png",
      "icons/beta/128x128@2x.png",
      "icons/beta/icon.icns",
      "icons/beta/icon.ico"
    ],
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "../../../script/sign-windows.ps1", "%1"]
      },
      "nsis": {
        "installerIcon": "icons/beta/icon.ico",
        "installerHooks": "./nsis/installer-hooks.nsh",
        "template": "./nsis/installer.nsis"
      }
    },
    "linux": {
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgREM5MzU5MTE5NjgxNEE2OQpSV1JwU29HV0VWbVQzSE96NlBYakdKMHJ2QXF3Sk9GWGFzekIrV1M0RlRkU3hkbllPVzN3Y280dw==",
      "endpoints": ["https://www.dd322.cn/update/code/{{target}}-{{arch}}/latest.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
