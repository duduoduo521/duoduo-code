{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DuoDuoCode",
  "identifier": "com.duoduo.desktop",
  "mainBinaryName": "DuoDuoCode",
  "version": "../package.json",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": {
        "//": "MUST stay in sync with CSP_POLICY in ../../scripts/inject-csp.ts. Multiple CSPs (this one plus the <meta> tag) are enforced together and the strictest wins, so a divergence silently blocks resources. wasm-unsafe-eval is required: the frontend loads WebAssembly (Shiki onig.wasm, ghostty-vt.wasm, pdfjs wasm). Also: dangerousDisableAssetCspModification above is scoped to style-src so Tauri does not add a nonce there - a nonce would make browsers ignore 'unsafe-inline' and silently break all inline styles in prod (splash layout, runtime theme/diff <style> injection, string style props).",
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "worker-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: https://asset.localhost data: blob: https:",
        "font-src": "'self' data:",
        "frame-src": "'self' http://localhost:* http://127.0.0.1:*",
        "media-src": "'self' data: blob: https:",
        "connect-src": "'self' ipc: http://ipc.localhost data: https: ws: wss: http://localhost:* http://127.0.0.1:*"
      }
    }
  },
  "bundle": {
    "icon": [
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns",
      "icons/dev/icon.ico"
    ],
    "active": true,
    "category": "DeveloperTool",
    "targets": ["deb", "rpm", "dmg", "nsis", "app"],
    "externalBin": [
      "sidecars/duoduocode-cli",
      "sidecars/duo-smart-layer"
    ],
    "resources": [
      "WebView2Loader.dll",
      "LICENSE",
      "ThirdPartyLicenses.txt"
    ],
    "linux": {
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    },
    "macOS": {
      "entitlements": "./entitlements.plist"
    },
    "windows": {
      "signCommand": {
        "cmd": "powershell",
        "args": ["-ExecutionPolicy", "Bypass", "-File", "../../../script/sign-windows.ps1", "%1"]
      },
      "nsis": {
        "installerIcon": "icons/dev/icon.ico",
        "headerImage": "assets/nsis-header.bmp",
        "sidebarImage": "assets/nsis-sidebar.bmp",
        "installerHooks": "./nsis/installer-hooks.nsh",
        "template": "./nsis/installer.nsis"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["duoduo"]
      }
    },
    "updater": {
      "endpoints": ["https://www.dd322.cn/update/code/{{target}}-{{arch}}/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgREM5MzU5MTE5NjgxNEE2OQpSV1JwU29HV0VWbVQzSE96NlBYakdKMHJ2QXF3Sk9GWGFzekIrV1M0RlRkU3hkbllPVzN3Y280dw=="
    }
  }
}
